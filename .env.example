# Copia este archivo como .env y llena los datos de tu instancia de Neo4j AuraDB.
# Los encuentras en el archivo "Neo4j-xxxx-Created-xxxx.txt" que AuraDB descarga al crear la instancia.

# URI de conexión (siempre empieza con neo4j+s:// en AuraDB: conexión cifrada TLS)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=5456ff0c
NEO4J_PASSWORD=tu_password_de_aura
# En AuraDB Free la base de datos se llama "neo4j"
NEO4J_DATABASE=neo4j

# Puerto local del servidor Express
PORT=3000
